{
  "name": "caresphere-core",
  "version": "1.0.0",
  "private": true,
  "description": "CareSphere Core Engines, APIs, Frontend, and Mobile Expo",
  "scripts": {
    "dev:backend": "python backend_api.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "test": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:mobile": "npm --prefix mobile run test:engine"
  }
}
