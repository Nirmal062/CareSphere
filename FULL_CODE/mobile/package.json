    "@types/pako": "^2.0.4",
    "expo": "~52.0.28",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.1",
    "expo-crypto": "^58.0.7",
    "expo-file-system": "^58.0.13",
